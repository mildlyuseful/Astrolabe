<Project Sdk="Microsoft.NET.Sdk">
  <!-- TrackballNav AutoCAD plugin: NETLOAD-able .NET 8 assembly that gives the trackball daemon a
       SMOOTH, regen-free orbit via AutoCAD's GraphicsSystem (GsView) - the API native 3DORBIT uses,
       which external COM automation cannot reach. See docs/apps/autocad.md, "Keep one camera writer."

       Local compile (needs the .NET 8 SDK; VS not required):
           dotnet build -c Release plugin_src/autocad/TrackballNavAcad
       Publish the bundled DLL and its provenance manifest only through
       tools/build_autocad_plugin.ps1. References resolve against the INSTALLED AutoCAD (no ObjectARX
       SDK needed); AutoCAD 2025-2027 share the .NET 8 binary-compatible family. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TrackballNavAcad</AssemblyName>
    <!-- Keep in sync with Plugin.PluginVersion; version.json for the daemon's update check is
         generated from this on Release build. -->
    <Version>0.3.17</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DebugType>none</DebugType>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AcadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
