# Normalize line endings across the mixed toolchain (Python, C#, Ruby, Arduino, Markdown).
* text=auto

# Binaries — never normalize.
*.dll binary
*.png binary
*.ico binary

# Verbatim published license texts. Their trailing whitespace is part of the document as its
# author published it, so `git diff --check` must not ask anyone to "fix" it.
LICENSE -whitespace
DCO -whitespace
LICENSES/** -whitespace
trackball_daemon/plugins/**/LICENSE -whitespace
