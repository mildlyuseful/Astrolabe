#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bootloader_recovery {
            timeout-ms = <120>;
            key-positions = <0 2 4>;
            bindings = <&bootloader>;
        };

        reset_recovery {
            timeout-ms = <120>;
            key-positions = <1 3 4>;
            bindings = <&sys_reset>;
        };

        next_ble_profile {
            timeout-ms = <120>;
            key-positions = <0 3 4>;
            bindings = <&bt BT_NXT>;
        };

        toggle_output {
            timeout-ms = <120>;
            key-positions = <0 1 4>;
            bindings = <&out OUT_TOG>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // Up, Down, Left, Right, Center. param1 is the frozen protocol bit;
            // param2 is the standalone HID mouse-button mask (zero means reserved).
            bindings = <
                &astro 0 0
                &astro 1 MB1
                &astro 2 0
                &astro 3 MB2
                &astro 4 MB3
            >;
        };
    };
};

