{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrolabe.dev/schemas/device-descriptor-v1.schema.json",
  "title": "Astrolabe BLE and USB device descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "source_id", "label", "match", "service_uuid", "motion_characteristic", "input_characteristic", "controls"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "device_id": {"$ref": "#/$defs/identifier"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
    "label": {"$ref": "#/$defs/text"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advertised_names"],
      "properties": {
        "advertised_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "usb_hid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor_id", "product_id", "usage_page", "usage", "product"],
          "properties": {
            "vendor_id": {"$ref": "#/$defs/uint16"},
            "product_id": {"$ref": "#/$defs/uint16"},
            "usage_page": {"$ref": "#/$defs/uint16"},
            "usage": {"$ref": "#/$defs/uint16"},
            "product": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "service_uuid": {"$ref": "#/$defs/uuid"},
    "motion_characteristic": {"$ref": "#/$defs/uuid"},
    "input_characteristic": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "keepalive_characteristic": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "bit"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "label": {"$ref": "#/$defs/text"},
          "bit": {"type": "integer", "minimum": 0, "maximum": 255},
          "kind": {"enum": ["button", "switch"]},
          "metadata": {"type": "object"}
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^\\S+$"},
    "text": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "uint16": {"type": "integer", "minimum": 0, "maximum": 65535},
    "uuid": {"type": "string", "format": "uuid"}
  }
}
