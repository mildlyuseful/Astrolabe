    "navigation.routing.object.translate_y.source": 1,
    "navigation.routing.object.translate_z.invert": false,
    "navigation.routing.object.translate_z.source": 2,
    "navigation.routing.object.yaw.invert": false,
    "navigation.routing.object.yaw.source": 1,
    "navigation.routing.pan.x.invert": false,
    "navigation.routing.pan.x.source": 1,
    "navigation.routing.pan.y.invert": false,
    "navigation.routing.pan.y.source": 0,
